<Window x:Class="SOULEYMANE_ADJERIME_CALCULATRICE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SOULEYMANE_ADJERIME_CALCULATRICE"
        mc:Ignorable="d"
        Title="Calculatrice" Height="560" Width="480">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F0C29" Offset="0"/>
            <GradientStop Color="#302B63" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="130"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Resources>

            <!-- Style de base : chiffres (bleu vif) -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="6"/>
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#3A86FF"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="30,8,30,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="8"
                                                      ShadowDepth="3" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Opérateurs : orange vif -->
            <Style x:Key="StyleOperateur" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#FF9F1C"/>
            </Style>

            <!-- Bouton C : rose/rouge vif -->
            <Style x:Key="StyleC" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#FF006E"/>
            </Style>

            <!-- Bouton = : vert vif -->
            <Style x:Key="StyleEgal" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#06D6A0"/>
            </Style>

        </Grid.Resources>

        <!-- Afficheur -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Margin="6"
                Background="#0A0A14" CornerRadius="25,8,25,8">
            <TextBox Name="TB_Display"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#06D6A0" FontSize="44" FontWeight="Bold"
                     IsReadOnly="True"
                     HorizontalContentAlignment="Right"
                     VerticalContentAlignment="Center"
                     Margin="15,0"/>
        </Border>

        <!-- Ligne 1 -->
        <Button Grid.Row="1" Grid.Column="0" Name="BTN_1" Content="1" Click="BTN_1_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Name="BTN_2" Content="2" Click="BTN_2_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Name="BTN_3" Content="3" Click="BTN_3_Click"/>
        <Button Grid.Row="1" Grid.Column="3" Name="BTN_Plus" Content="+" Click="BTN_Plus_Click"
                Style="{StaticResource StyleOperateur}"/>

        <!-- Ligne 2 -->
        <Button Grid.Row="2" Grid.Column="0" Name="BTN_4" Content="4" Click="BTN_4_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Name="BTN_5" Content="5" Click="BTN_5_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Name="BTN_6" Content="6" Click="BTN_6_Click"/>
        <Button Grid.Row="2" Grid.Column="3" Name="BTN_Moin" Content="-" Click="BTN_Moins_Click"
                Style="{StaticResource StyleOperateur}"/>

        <!-- Ligne 3 -->
        <Button Grid.Row="3" Grid.Column="0" Name="BTN_7" Content="7" Click="BTN_7_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Name="BTN_8" Content="8" Click="BTN_8_Click"/>
        <Button Grid.Row="3" Grid.Column="2" Name="BTN_9" Content="9" Click="BTN_9_Click"/>
        <Button Grid.Row="3" Grid.Column="3" Name="BTN_Multiplication" Content="x" Click="BTN_Multiplication_Click"
                Style="{StaticResource StyleOperateur}"/>

        <!-- Ligne 4 -->
        <Button Grid.Row="4" Grid.Column="0" Name="BTN_0" Content="0" Click="BTN_0_Click"/>
        <Button Grid.Row="4" Grid.Column="1" Name="BTN_C" Content="C" Click="BTN_C_Click"
                Style="{StaticResource StyleC}"/>
        <Button Grid.Row="4" Grid.Column="2" Name="BTN_Division" Content="/" Click="BTN_Division_Click"
                Style="{StaticResource StyleOperateur}"/>
        <Button Grid.Row="4" Grid.Column="3" Name="BTN_Egal" Content="=" Click="BTN_Egal_Click"
                Style="{StaticResource StyleEgal}"/>
    </Grid>
</Window>
